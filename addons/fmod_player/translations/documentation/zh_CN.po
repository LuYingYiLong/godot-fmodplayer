msgid "Extended Module format (XM)."
msgstr "FastTracker 2 扩展模块（.xm）"

#. FmodDSP/constants:6/constant:DSP_PARAMETER_DATA_TYPE_FFT
msgid "FFT spectrum data parameter type."
msgstr "FFT 频谱数据参数类型。"

#. FmodAudioEffectPitchShift/constants:6/constant:FFT_SIZE_1024
msgid "FFT window size of 1024 samples. Balanced latency and frequency resolution."
msgstr "1024 点 FFT"

#. FmodAudioEffectPitchShift/constants:6/constant:FFT_SIZE_2048
msgid ""
"FFT window size of 2048 samples. Good frequency resolution with acceptable latency. This is the "
"default setting."
msgstr "2048 点 FFT"

#. FmodAudioEffectPitchShift/constants:6/constant:FFT_SIZE_256
msgid ""
"FFT window size of 256 samples. Lowest latency but poorest frequency resolution. Best for real-"
