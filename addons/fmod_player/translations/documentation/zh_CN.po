msgid "Sets [member attack_us]."
msgstr "设置 [member attack_us] 。"

#. FmodAudioStreamPlayer3D/methods:3/method:set_attenuation_filter_db/description:2
msgid "Sets [member attenuation_filter_db]. Updates the native filter immediately during playback."
msgstr "设置 [member attenuation_filter_db] 。播放期间会立即更新原生滤波器。"

#. FmodAudioStream/methods:3/method:set_audio_data/description:2
msgid "Sets [member audio_data]."
