msgstr "为 [code]true[/code] 时暂停通道播放。"

#. FmodAudioEffectRecord/members:4/member:recording_active
msgid ""
"If [code]true[/code], the effect is currently recording audio from the bus. Set to "
"[code]true[/code] to start recording and [code]false[/code] to stop. After stopping, call [method"
" get_recording] to retrieve the captured audio."
msgstr "是否正在录制 （参见 [method get_recording] ）"

#. FmodAudioEffectDelay/members:4/member:feedback_active
msgid "If [code]true[/code], the feedback loop is active, creating repeating echoes."
msgstr "是否启用反馈延迟"

#. FmodChannelControl/members:4/member:volume_ramp
msgid ""
"If [code]true[/code], volume changes are ramped smoothly over time. If [code]false[/code], volume"
" changes are instantaneous."
msgstr "音量变化是否使用平滑斜坡"

#. FmodAudioStreamPlayer/methods:3/method:set_preload_on_set_stream/description:2
#. FmodAudioStreamPlayer2D/methods:3/method:set_preload_on_set_stream/description:2
#. FmodAudioStreamPlayer3D/methods:3/method:set_preload_on_set_stream/description:2
