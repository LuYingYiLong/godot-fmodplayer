msgstr "256 点 FFT"

#. FmodAudioEffectPitchShift/constants:6/constant:FFT_SIZE_4096
msgid ""
"FFT window size of 4096 samples. Highest frequency resolution but highest latency. Best for "
"offline processing or when quality is more important than real-time response."
msgstr "4096 点 FFT"

#. FmodAudioEffectPitchShift/constants:6/constant:FFT_SIZE_512
msgid "FFT window size of 512 samples. Low latency with moderate frequency resolution."
msgstr "512 点 FFT"

#. FmodSound/constants:6/constant:FMOD_SOUND_TYPE_FADPCM
msgid "FMOD ADPCM compression format."
msgstr "FMOD 自适应差分脉冲码调制比特流，支持FSB（.fsb）容器格式"

#. FmodSound/constants:6/constant:FMOD_SOUND_TYPE_FSB
