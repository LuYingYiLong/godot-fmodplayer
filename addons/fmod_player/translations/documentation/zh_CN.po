#. FmodAudioStream/members:4/member:dls_name
msgid "Optional DLS or SF2 bank path used by MIDI/DLS content."
msgstr "MIDI/DLS 内容使用的可选 DLS 或 SF2 音色库路径。"

#. FmodAudioStream/members:4/member:decode_buffer_size
msgid ""
"Optional FMOD decode buffer size in PCM samples. A value of [code]0[/code] lets FMOD choose its "
"default."
msgstr "可选的 FMOD 解码缓冲大小，单位为 PCM 采样数。 [code]0[/code] 表示使用 FMOD 默认值。"

#. FmodAudioStream/members:4/member:suggested_sound_type
msgid ""
"Optional FMOD sound type hint. Leave as unknown for normal audio files; set this for raw PCM or "
"ambiguous/special container formats."
msgstr "可选的 FMOD 声音类型提示。普通音频文件保留未知类型；原始 PCM 或难以识别的特殊容器格式可指定类型。"

#. FmodAudioStream/members:4/member:length_override
msgid ""
"Optional byte length passed to FMOD, clamped to the size of [member audio_data]. A value of "
"[code]0[/code] uses the complete data size."
msgstr "传递给 FMOD 的可选字节长度，上限为 [member audio_data] 的大小。 [code]0[/code] 表示使用全部数据。"

#. FmodAudioStream/members:4/member:file_offset
msgid ""
"Optional byte offset passed to [code]FMOD_CREATESOUNDEXINFO.fileoffset[/code]. Leave at "
"[code]0[/code] for normal imported files."
msgstr "传给 [code]FMOD_CREATESOUNDEXINFO.fileoffset[/code] 的可选字节偏移。普通导入文件保留 [code]0[/code] 。"

#. FmodAudioStream/members:4/member:initial_seek_position
msgid "Optional initial seek position. The unit is controlled by [member initial_seek_postype]."
msgstr "可选的初始定位位置，单位由 [member initial_seek_postype] 决定。"

#. FmodAudioStream/members:4/member:initial_subsound
msgid "Optional initial subsound index for container formats. [code]-1[/code] lets FMOD use its default."
msgstr "容器格式的可选初始子声音索引， [code]-1[/code] 表示使用 FMOD 默认值。"

#. FmodAudioStream/members:4/member:encryption_key
msgid "Optional key used when opening encrypted FMOD-compatible audio data."
msgstr "打开 FMOD 支持的加密音频数据时使用的可选密钥。"

#. FmodAudioStream/members:4/member:max_polyphony
msgid ""
"Optional maximum polyphony for formats that support it. A value of [code]0[/code] leaves FMOD's "
"default unchanged."
msgstr "可选的最大复音数，仅适用于支持此设置的格式。 [code]0[/code] 保留 FMOD 默认值。"

#. FmodGeometryInstance3D/members:4/member:source_node_path
msgid "Optional source node path for mesh or collision shape conversion."
msgstr "指定要扫描的源节点路径"

#. FmodAudioStream/members:4/member:num_subsounds
msgid "Optional subsound count override for container formats."
msgstr "容器格式的可选子声音数量覆盖值。"

#. FmodAudioStream/members:4/member:inclusion_list
msgid "Optional subsound inclusion list used by container formats."
msgstr "容器格式使用的可选子声音包含列表。"

#. FmodSound/constants:6/constant:FMOD_SOUND_TYPE_OPUS
msgid "Opus audio codec."
msgstr "Opus 比特流支持，支持 FSB（.fsb）容器格式。平台提供解码器，仅支持 Xbox Series X|S、PS5 和 Switch"

#. FmodReverbZone3D/constants:6/constant:PRESET_ALLEY
msgid "Outdoor alley preset."
msgstr "小巷"

#. FmodReverbZone3D/constants:6/constant:PRESET_CITY
msgid "Outdoor city ambience preset."
msgstr "城市"

#. FmodReverbZone3D/constants:6/constant:PRESET_FOREST
msgid "Outdoor forest ambience preset."
msgstr "森林"

#. FmodDSP/constants:6/constant:DSP_PARAMETER_DATA_TYPE_OVERALLGAIN
msgid "Overall gain data parameter type."
msgstr "整体增益数据参数类型。"

#. FmodReverbZone3D/members:4/member:wet_level
msgid "Overall wet level in dB."
msgstr "混响湿声电平，单位为分贝"

#. FmodAudioEffectDistortion/constants:6/constant:MODE_OVERDRIVE
msgid "Overdrive. Simulates analog tube amplifier distortion with warm, musical saturation."
msgstr "过载失真"

#. FmodDSP/constants:6/constant:DSP_TYPE_FADER
msgid "Pans and scales the volume of the unit."
msgstr "调整声像和音量。"

#. FmodSystem/constants:6/constant:FMOD_PORT_TYPE_PASSTHROUGH
msgid "Passthrough output port. Use [code]FMOD_PORT_INDEX_NONE[/code] as the port index."
msgstr "直通输出端口"

#. FmodAudioStreamPlayer/methods:3/method:set_stream_paused/description:2
#. FmodAudioStreamPlayer2D/methods:3/method:set_stream_paused/description:2
#. FmodAudioStreamPlayer3D/methods:3/method:set_stream_paused/description:2
msgid "Pauses or resumes playback without changing position."
msgstr "暂停或恢复当前播放流"

#. FmodAudioEffectEQ/constants:6/constant:FILTER_PEAKING
msgid ""
"Peaking EQ filter for boosting or cutting a specific frequency range. This is the default filter "
"type for EQ bands."
msgstr "峰值滤波"

#. FmodAudioStream/members:4/member:resampler_method
msgid "Per-sound resampler; Default follows the system setting."
msgstr "单个声音的重采样方法；Default 跟随系统设置。"

#. FmodSound/constants:6/constant:FMOD_OPEN_STATE_SEEKING
msgid "Performing a seek operation."
msgstr "正在定位子声道并强制刷新流缓冲区"

#. FmodSound/constants:6/constant:FMOD_OPEN_STATE_SETPOSITION
msgid "Performing a setPosition operation."
msgstr "在流中寻找不同的位置"

#. FmodAudioEffectSpectrumAnalyzer/brief_description:0
msgid "Performs real-time frequency spectrum analysis on audio signals for visualization and analysis."
msgstr "频谱分析器，可读取频段幅度、RMS 和频谱重心。"

#. FmodSystem/constants:6/constant:FMOD_PORT_TYPE_PERSONAL
msgid ""
"Personal audio device port (e.g., headphones, headset).\n"
"Use the platform-specific user ID as the port index."
msgstr ""
"个人音频输出端口\n"
"使用平台专用的用户 ID 作为端口索引。"

#. FmodAudioEffectPhaser/brief_description:0
msgid "Phaser effect using a modulated chain of six all-pass filters."
msgstr "使用六级全通滤波器调制链的移相效果器。"

#. FmodAudioStreamPlayer/members:4/member:pitch_scale
#. FmodAudioStreamPlayer2D/members:4/member:pitch_scale
#. FmodAudioStreamPlayer3D/members:4/member:pitch_scale
msgid "Pitch scale of the audio. [code]1.0[/code] is the default pitch."
msgstr "播放速度和音高缩放"

#. FmodAudioEffectPitchShift/brief_description:0
msgid "Pitch shifter for changing the pitch of audio without affecting playback speed."
msgstr "音高变换效果。"

#. FmodSound/constants:6/constant:FMOD_SOUND_TYPE_AT9
msgid "PlayStation 4 ATRAC9 format."
msgstr "PlayStation 4 ATRAC9 格式。"

#. FmodSystem/constants:6/constant:FMOD_OUTPUT_TYPE_AUDIO3D
msgid "PlayStation Audio3D output."
msgstr "PlayStation Audio3D 输出。"

#. FmodSystem/constants:6/constant:FMOD_OUTPUT_TYPE_AUDIOOUT
msgid "PlayStation AudioOut output."
msgstr "音频输出（PS4、PS5默认）"

#. FmodChannel/members:4/member:frequency
msgid ""
"Playback frequency in Hz. Changing it affects both playback speed and pitch. Values assigned to "
"this property must be greater than [code]0.0[/code]. A wrapper without a Channel pointer reports "
"[code]0.0[/code]."
msgstr "播放频率，单位为 Hz，改变它会同时影响速度和音高。设置值必须大于 [code]0.0[/code] ；没有 Channel 指针的封装读取时返回 [code]0.0[/code] 。"

#. FmodSound/constants:6/constant:FMOD_SOUND_TYPE_PLAYLIST
msgid "Playlist file format (M3U/PLS)."
msgstr "播放列表信息容器（.asx、.pls、.m3u、.wax）。无音频，仅有标签"

#. FmodSound/constants:6/constant:FMOD_TAG_TYPE_PLAYLIST
msgid "Playlist file metadata."
msgstr "播放列表文件如PLS、M3U、ASX和WAX会通过该标签类型填充播放列表信息"

#. FmodAudioStreamPlayer3D/description:1
msgid ""
"Plays [FmodAudioStream] in 3D using FMOD positioning, rolloff, optional Doppler tracking, and an "
"emission cone. Playback controls, pitch, volume, and bus routing are shared with the other FMOD "
"players."
msgstr "使用 FMOD 的空间定位、距离衰减、可选多普勒跟踪和发射锥，在 3D 空间播放 [FmodAudioStream] 。播放控制、音调、音量和总线路由与其他 FMOD 播放器共用。"

#. FmodAudioStreamPlayer/description:1
msgid ""
"Plays [FmodAudioStream] resources through FMOD with volume in decibels, a pitch multiplier, "
"playback controls, speaker mix targets, and bus routing."
msgstr "通过 FMOD 播放 [FmodAudioStream] ，支持分贝音量、音调倍率、播放控制、扬声器混音目标和总线路由。"

#. FmodAudioStreamPlayer2D/description:1
msgid ""
"Plays [FmodAudioStream] resources with distance attenuation and stereo panning relative to the 2D"
" listener. Each player uses one playback channel."
msgstr "播放 [FmodAudioStream] ，根据与 2D 监听器的距离和方位调整衰减与立体声声像。每个播放器使用一个播放通道。"

#. FmodSystem/methods:3/method:play_dsp/description:4
msgid ""
"Plays a DSP and its input signals on a channel, routed through the specified channel group.\n"
"If paused is [code]true[/code], the channel starts in a paused state and won't produce sound "
"until [method FmodChannelControl.set_paused] is called with [code]false[/code]."
msgstr ""
"在通道上播放 DSP 及其输入信号，通过指定的通道组路由。\n"
"如果 [code skip-lint]paused[/code] 为 [code]true[/code] ，通道将以暂停状态开始，直到调用 [method "
"FmodChannelControl.set_paused] 并传入 [code]false[/code] 才会产生声音。"

#. FmodSystem/methods:3/method:play_sound/description:4
msgid ""
"Plays a sound on a channel, routed through the specified channel group.\n"
"If paused is [code]true[/code], the channel starts in a paused state and won't produce sound "
"until [method FmodChannelControl.set_paused] is called with [code]false[/code].\n"
"Returns a [FmodChannel] handle that can be used to control playback."
msgstr ""
"在一个通道上播放声音，通过指定的通道组路由。\n"
"如果 [code skip-lint]paused[/code] 为 [code]true[/code] ，通道将以暂停状态开始，直到调用 [method "
"FmodChannelControl.set_paused] 并传入 [code]false[/code] 才会产生声音。\n"
"返回一个 [FmodChannel] 句柄，可用于控制播放。"

#. FmodAudioStreamPlayer/methods:3/method:preload_stream/description:1
#. FmodAudioStreamPlayer2D/methods:3/method:preload_stream/description:1
#. FmodAudioStreamPlayer3D/methods:3/method:preload_stream/description:1
msgid ""
"Preloads the assigned stream by creating its internal [FmodSound]. Returns [code]false[/code] if "
"no stream is assigned or sound creation fails."
msgstr "通过创建内部 [FmodSound] 预加载音频流。未设置音频流或声音创建失败时返回 [code]false[/code] 。"

#. FmodSound/constants:6/constant:FMOD_SOUND_TYPE_MOD
msgid "ProTracker module format (MOD)."
msgstr "Protracker / Fasttracker 模块文件"

#. FmodDSP/constants:6/constant:DSP_MODE_FILTER
msgid "Processes input audio."
msgstr "处理输入音频。"

#. FmodDSP/constants:6/constant:DSP_TYPE_CHORUS
msgid "Produces a chorus effect on the sound."
msgstr "生成合唱效果。"

#. FmodDSP/constants:6/constant:DSP_TYPE_FLANGE
msgid "Produces a flange effect on the sound."
msgstr "生成镶边效果。"

#. FmodDSP/constants:6/constant:DSP_TYPE_TREMOLO
msgid "Produces a tremolo/chopping effect on the sound."
msgstr "生成震音或断续效果。"

#. FmodDSP/constants:6/constant:DSP_TYPE_DELAY
msgid "Produces different delays on individual channels of the sound."
msgstr "为各声道设置不同的延迟。"

#. FmodDSP/constants:6/constant:DSP_TYPE_ECHO
msgid "Produces echo on the sound and fades at the desired rate."
msgstr "生成回声，并按指定速率衰减。"

#. FmodDSP/constants:6/constant:DSP_TYPE_ITECHO
msgid "Produces echo on the sound and fades at the rate used in Impulse Tracker."
msgstr "生成回声，并按 Impulse Tracker 使用的速率衰减。"

