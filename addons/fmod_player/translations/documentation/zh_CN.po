#. FmodGeometryInstance3D/methods:3/method:get_double_sided/description:1
msgid "Returns [member double_sided]."
msgstr "返回 [member double_sided] 。"

#. FmodAudioEffectReverb/methods:3/method:get_dry/description:1
msgid "Returns [member dry]."
msgstr "返回 [member dry] 。"

#. FmodReverbZone3D/methods:3/method:get_early_delay/description:1
msgid "Returns [member early_delay]."
msgstr "返回 [member early_delay] 。"

#. FmodReverbZone3D/methods:3/method:get_early_late_mix/description:1
msgid "Returns [member early_late_mix]."
msgstr "返回 [member early_late_mix] 。"

#. FmodAudioStream/methods:3/method:get_encryption_key/description:1
msgid "Returns [member encryption_key]."
msgstr "返回 [member encryption_key] 。"

#. FmodAudioEffectPitchShift/methods:3/method:get_fft_size/description:1
#. FmodAudioEffectSpectrumAnalyzer/methods:3/method:get_fft_size/description:1
msgid "Returns [member fft_size]."
msgstr "返回 [member fft_size] 。"

#. FmodAudioStream/methods:3/method:get_file_offset/description:1
msgid "Returns [member file_offset]."
