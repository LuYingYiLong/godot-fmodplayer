msgid "Maximum value for bounds checking."
msgstr "支持的最大声音类型"

#. FmodGeometryInstance3D/members:4/member:mesh
msgid "Mesh source used when [member source_mode] is [constant SOURCE_MESH_RESOURCE]."
msgstr "直接用于构建遮挡几何体的网格资源 （参见 [member source_mode] ） （参见 [constant SOURCE_MESH_RESOURCE] ）"

