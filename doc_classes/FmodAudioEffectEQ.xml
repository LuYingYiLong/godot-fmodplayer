	<constants>
		<constant name="PRESET_6_BANDS" value="0" enum="Preset">
			6-band equalizer preset with frequencies: 32Hz, 100Hz, 320Hz, 1000Hz, 3200Hz, 10000Hz.
		</constant>
		<constant name="PRESET_10_BANDS" value="1" enum="Preset">
