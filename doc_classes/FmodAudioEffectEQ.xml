<?xml version="1.0" encoding="UTF-8" ?>
<class xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="FmodAudioEffectEQ" inherits="FmodAudioEffect" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Base class for multi-band equalizer audio effects.
	</brief_description>
	<description>
		FmodAudioEffectEQ is a base class for multi-band equalizer audio effects using FMOD's MULTIBAND_EQ DSP. It provides flexible frequency equalization with support for multiple bands, each with independent gain, frequency, Q value, and filter type.
		The effect supports three preset configurations: 6-band, 10-band, and 21-band equalizers. Each band uses a peaking filter by default, but can be configured with other filter types including low-pass, high-pass, low-shelf, high-shelf, and more.
		To apply this effect to an audio bus, use [method FmodAudioEffect.apply_to] and pass a [FmodChannelGroup].
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="set_preset">
			<return type="void" />
			<param index="0" name="preset" type="int" enum="FmodAudioEffectEQ.Preset" />
			<description>
				Sets [member preset].
			</description>
		</method>
		<method name="get_preset" qualifiers="const">
			<return type="int" enum="FmodAudioEffectEQ.Preset" />
			<description>
				Returns [member preset].
			</description>
		</method>
		<method name="get_band_count" qualifiers="const">
			<return type="int" />
			<description>
				Returns the number of bands in this equalizer, which depends on the preset (6, 10, or 21).
			</description>
		</method>
		<method name="set_band_gain_db">
			<return type="void" />
			<param index="0" name="band_idx" type="int" />
			<param index="1" name="gain_db" type="float" />
			<description>
				Sets the gain (in dB) for the specified band. The value is clamped to the range -60 dB to +24 dB.
			</description>
		</method>
		<method name="get_band_gain_db" qualifiers="const">
			<return type="float" />
			<param index="0" name="band_idx" type="int" />
			<description>
				Returns the gain (in dB) for the specified band. The value ranges from -60 dB to +24 dB.
			</description>
		</method>
		<method name="set_band_frequency">
			<return type="void" />
			<param index="0" name="band_idx" type="int" />
			<param index="1" name="frequency" type="float" />
			<description>
				Sets the center frequency (in Hz) for the specified band. Valid range is 10 Hz to 22000 Hz.
			</description>
		</method>
		<method name="get_band_frequency" qualifiers="const">
			<return type="float" />
			<param index="0" name="band_idx" type="int" />
			<description>
				Returns the center frequency (in Hz) for the specified band.
			</description>
		</method>
		<method name="set_band_filter_type">
			<return type="void" />
			<param index="0" name="band_idx" type="int" />
			<param index="1" name="filter_type" type="int" enum="FmodAudioEffectEQ.FilterType" />
			<description>
				Sets the filter type for the specified band. See [enum FilterType] for available filter types.
			</description>
		</method>
		<method name="get_band_filter_type" qualifiers="const">
			<return type="int" enum="FmodAudioEffectEQ.FilterType" />
			<param index="0" name="band_idx" type="int" />
			<description>
				Returns the filter type for the specified band. See [enum FilterType] for possible values.
			</description>
		</method>
		<method name="set_band_q">
			<return type="void" />
			<param index="0" name="band_idx" type="int" />
			<param index="1" name="q" type="float" />
			<description>
				Sets the Q value (quality factor) for the specified band. Valid range is 0.01 to 10.0. Higher values create a narrower, more selective filter.
			</description>
		</method>
		<method name="get_band_q" qualifiers="const">
			<return type="float" />
			<param index="0" name="band_idx" type="int" />
			<description>
				Returns the Q value (quality factor) for the specified band. Higher Q values result in a narrower bandwidth.
			</description>
		</method>
	</methods>
