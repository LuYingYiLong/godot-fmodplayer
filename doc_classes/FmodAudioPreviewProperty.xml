			<return type="void" />
			<param index="0" name="stream" type="FmodAudioStream" />
			<description>
				Sets the [FmodAudioStream] to preview. This regenerates the waveform display.
			</description>
		</method>
		<method name="get_stream" qualifiers="const">
			<return type="FmodAudioStream" />
			<description>
				Returns the [FmodAudioStream] currently being previewed.
