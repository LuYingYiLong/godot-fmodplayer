<?xml version="1.0" encoding="UTF-8" ?>
<class xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="FmodAudioPreviewProperty" inherits="ColorRect" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Custom property editor control for previewing FMOD audio streams in the editor.
	</brief_description>
	<description>
		Displays an audio waveform, playback controls, a position indicator, and time labels for [FmodAudioStream] in the inspector. Clicking the waveform seeks playback.
		Waveform generation is deferred to a later main-thread call; it does not run on a background worker.
	</description>
