	<members>
		<member type="bool" name="active" setter="set_active" getter="get_active" default="true">
			Whether this reverb zone contributes to the FMOD mix.
		</member>
		<member type="bool" name="sync_transform" setter="set_sync_transform" getter="get_sync_transform" default="true">
			If enabled, the internal FMOD reverb position follows this node every frame.
		</member>
		<member type="float" name="min_distance" setter="set_min_distance" getter="get_min_distance" default="5.0">
			Distance from the center where the reverb is fully applied.
		</member>
		<member type="float" name="max_distance" setter="set_max_distance" getter="get_max_distance" default="20.0">
			Distance from the center where the reverb fades out.
		</member>
