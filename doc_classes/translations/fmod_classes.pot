msgstr ""

#. FmodDSP/constants:6/constant:DSP_TYPE_FLANGE
msgid "Produces a flange effect on the sound."
msgstr ""

#. FmodDSP/constants:6/constant:DSP_TYPE_TREMOLO
msgid "Produces a tremolo/chopping effect on the sound."
msgstr ""

#. FmodDSP/constants:6/constant:DSP_TYPE_DELAY
msgid "Produces different delays on individual channels of the sound."
msgstr ""

#. FmodDSP/constants:6/constant:DSP_TYPE_ECHO
msgid "Produces echo on the sound and fades at the desired rate."
msgstr ""

#. FmodDSP/constants:6/constant:DSP_TYPE_ITECHO
msgid "Produces echo on the sound and fades at the rate used in Impulse Tracker."
msgstr ""

